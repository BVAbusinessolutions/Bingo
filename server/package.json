{
  "name": "hogar-sol-bingo-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test --test-concurrency=1 --env-file-if-exists=.env.test \"test/**/*.test.js\"",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "demo:cartones": "node --env-file-if-exists=.env scripts/demo-cartones.js",
    "lint": "eslint .",
    "format": "prettier --write src test scripts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "5.3.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.5.0",
    "nodemailer": "^10.2.1",
    "pg": "8.23.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "tesseract.js": "^5.1.1",
    "yauzl": "3.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
