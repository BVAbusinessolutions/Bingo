# =====================================================================
#  Bingo Hogar Sol · configuración del servidor
#  Copia este archivo como .env (npm run setup lo hace por ti) y nunca lo subas a git.
# =====================================================================

PORT=4000
NODE_ENV=development
# URL pública de la web (enlaces de los correos y CORS). En producción: https://tu-dominio
CLIENT_ORIGIN=http://localhost:5173

# ---------- Base de datos (Supabase) ----------
# Panel de Supabase > Project Settings > Database > Connection string > "Session pooler" (puerto 5432).
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base. Sin DATABASE_URL, en desarrollo se usa
# una base local embebida (server/.data); en producción es obligatoria.
DATABASE_URL=
# TLS hacia Supabase: "require" (por defecto). Para verificar además el certificado del servidor,
# descarga el "SSL certificate" del panel y pon su ruta aquí (recomendado en producción).
DATABASE_SSL=require
DATABASE_CA_CERT=
DATABASE_POOL_MAX=10

# ---------- Sesiones ----------
# Genera cada secreto con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# El servidor no arranca si son cortos (<32), iguales entre sí o estos valores de ejemplo.
JWT_ACCESS_SECRET=cambia-esto
JWT_REFRESH_SECRET=cambia-esto-tambien
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ---------- Reglas del negocio ----------
RESERVATION_TTL_MIN=15
# Comprobantes de compras rechazadas/vencidas/canceladas se borran tras N días
PROOF_RETENTION_DAYS=90
# Bloqueo por cuenta tras N intentos fallidos de inicio de sesión
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15

# ---------- Producción ----------
# Cantidad de proxies delante del servidor (Render/Railway/Fly: 1). Afecta límites por IP y bitácora.
TRUST_PROXY=
# En producción el servidor entrega la web compilada (client/dist) con cabeceras de seguridad.
SERVE_CLIENT=
LOG_LEVEL=info
# Solo desarrollo: crea usuarios y datos de demostración en una base vacía (nunca en producción).
SEED_DEMO=true
# Solo desarrollo: compras de prueba para las cuentas demo (por defecto el inventario arranca en 0 vendidos).
SEED_DEMO_PURCHASES=false

# ---------- Datos de cobro iniciales ----------
# Después se editan desde el panel: Administración > Datos de cobro.
PAYMENT_HOLDER=Asociación Infantil Hogar Sol
PAYMENT_HOLDER_ID=3-002-000000
PAYMENT_SINPE_PHONE=6027-1658
PAYMENT_BANK=Banco Nacional de Costa Rica
PAYMENT_IBAN=CR00 0000 0000 0000 0000 00
# Opcionales: titular de la línea SINPE (si no es la Asociación) y BIC/SWIFT del banco
PAYMENT_SINPE_HOLDER=
PAYMENT_SWIFT=

# ---------- Correo ----------
# Aviso de cada compra nueva al administrador (varios separados por coma)
ADMIN_NOTIFY_EMAILS=bryanbs2595@gmail.com
# SMTP. Sin SMTP_HOST los correos solo se imprimen en la consola del servidor.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true y una "contraseña de aplicación"
# (https://myaccount.google.com/apppasswords), nunca la contraseña normal de la cuenta.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bingo Hogar Sol <tu-correo@gmail.com>

# ---------- Seguridad, transmisión y analítica ----------
# Redirige http -> https en el propio servidor (Render ya lo hace en su borde). Requiere TRUST_PROXY correcto.
FORCE_HTTPS=false
# Orígenes https permitidos para la transmisión LL-HLS / WebRTC-WHEP (separados por coma). Se agregan a la CSP
# y el panel solo acepta URLs de transmisión de estos orígenes. Ej.: https://customer-xxxx.cloudflarestream.com
STREAM_ORIGINS=
# Analítica sin costo: ga4 | cloudflare (mismo valor que VITE_ANALYTICS_PROVIDER en el cliente). Vacío = ninguna.
ANALYTICS_PROVIDER=
