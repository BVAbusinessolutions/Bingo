# Solo para pruebas automáticas (npm test). Valores ficticios: no se usan fuera de los tests.
NODE_ENV=test
PGLITE_DIR=memory
JWT_ACCESS_SECRET=test-access-secret-0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=test-refresh-secret-0123456789abcdef0123456789abcd
CLIENT_ORIGIN=http://localhost:5173
ADMIN_NOTIFY_EMAILS=admin-pruebas@example.com
MAX_FAILED_LOGINS=3
LOG_LEVEL=error
RATE_LIMIT_SCALE=100
STREAM_ORIGINS=https://stream.example.com

# Los tests de sorteo, reclamos y eventos usan las compras de prueba de las cuentas demo.
SEED_DEMO_PURCHASES=true
