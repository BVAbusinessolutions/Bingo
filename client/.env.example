# Muestra el botón de credenciales demo en /login (siempre visible en desarrollo)
VITE_SHOW_DEMO_LOGIN=false

# Datos públicos de contacto (pie de página y página /contacto). Reemplazar por los reales.
VITE_CONTACT_EMAIL=contacto@hogarsol.org
VITE_CONTACT_PHONE=+506 2222-0000
# WhatsApp: solo dígitos, con código de país
VITE_CONTACT_WHATSAPP=50688880000
VITE_CONTACT_ADDRESS=San José, Costa Rica
VITE_CONTACT_SCHEDULE=Lunes a viernes, 8:00 a. m. a 5:00 p. m.

# Fotografía HD del premio mayor (la motocicleta). Por defecto: client/public/img/premio-motocicleta.webp
# (horizontal, 1600×1000 px o más). Si no existe, la tarjeta se muestra sin foto.
VITE_PRIZE_IMAGE=

# Datos corporativos (aviso legal) y URL pública del sitio (SEO, enlaces canónicos y Open Graph).
VITE_ORG_LEGAL_ID=
VITE_SITE_URL=https://bingo.hogarsol.org

# Analítica sin costo (opcional; solo se carga si la persona acepta cookies de analítica).
# VITE_ANALYTICS_PROVIDER = ga4 | cloudflare. En el servidor poner el mismo valor en ANALYTICS_PROVIDER (CSP).
VITE_ANALYTICS_PROVIDER=
# GA4: ID de medición (G-XXXXXXXXXX). Cloudflare Web Analytics: token del beacon.
VITE_GA4_ID=
VITE_CF_BEACON_TOKEN=
